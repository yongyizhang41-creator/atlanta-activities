    "format": "prettier --write src e2e *.ts scripts",
    "format:check": "prettier --check src e2e *.ts scripts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
